#!/bin/bash

# Check if Ruby version is provided
if [ -z "$1" ]; then
  echo "Usage: $0 <ruby-version>"
  exit 1
fi

RUBY_VERSION=$1
IMAGE_NAME=${IMAGE_NAME:-ghcr.io/kramerc/rails-devcontainer/images/ruby}

devcontainer build --workspace-folder images/ruby --image-name "$IMAGE_NAME:$RUBY_VERSION" --output /tmp/output.tar
